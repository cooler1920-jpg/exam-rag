# Copy this file to ".env" and paste your real keys.
# Both are FREE. Get them here:
#   GEMINI_API_KEY   -> https://aistudio.google.com/app/apikey  (reads pages, makes embeddings, writes answers)
#   PINECONE_API_KEY -> https://app.pinecone.io  (the online searchable memory)

GEMINI_API_KEY=paste-your-gemini-key-here
PINECONE_API_KEY=paste-your-pinecone-key-here

# You usually don't need to change anything below.
PINECONE_INDEX=exam-rag
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
